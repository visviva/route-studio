@inject IJSRuntime JS
@implements IAsyncDisposable

<header class="topbar">
    <div class="shell nav">
        <a class="brand" href="./"><img src="compass.svg" alt="" width="40" height="40"><span>Route Studio<small>SC FARMING PATHS</small></span></a>
        <select id="language" aria-label="@Text["Language"]" @bind:get="Text.Preference" @bind:set="ChangeLanguage">
            <option value="">@Text["BrowserDefault"]</option>
            <option value="de" lang="de">Deutsch</option>
            <option value="en" lang="en">English</option>
            <option value="es" lang="es">Español</option>
            <option value="it" lang="it">Italiano</option>
            <option value="pt" lang="pt">Português</option>
        </select>
    </div>
</header>

<main class="shell">
    <section class="hero" aria-labelledby="hero-title">
        <h1 id="hero-title">Route <em>Studio</em></h1>
        <p>@Text["HeroDescription"]</p>
    </section>

    <dl class="metrics">
        <div><dt>@Text["Waypoints"]</dt><dd>@(_points.Count == 0 ? "—" : _points.Count.ToString("D2"))</dd></div>
        <div><dt>@Text["MapId"]</dt><dd>@(MapId is int id ? $"#{id}" : "—") @if (MapId == 2437) { <small>Zul’Aman</small> }</dd></div>
    </dl>

    <div class="workspace">
        <section class="panel editor" id="editor" aria-labelledby="editor-heading" @ref="_editor">
            <div class="panel-heading">
                <h2 id="editor-heading">@Text["Waypoints"]</h2>
                <button class="button secondary small" @onclick="LoadExample">@Text["LoadExample"]</button>
            </div>
            <div class="waypoint-tabs" role="tablist" aria-labelledby="editor-heading">
                <button type="button" id="text-tab" role="tab" aria-controls="text-panel" aria-selected="@(!_orderTab ? "true" : "false")"
                        tabindex="@(_orderTab ? -1 : 0)" @onclick="() => _orderTab = false">@Text["WaypointTextTab"]</button>
                <button type="button" id="order-tab" role="tab" aria-controls="order-panel" aria-selected="@(_orderTab ? "true" : "false")"
                        tabindex="@(_orderTab ? 0 : -1)" @onclick="() => _orderTab = true">@Text["WaypointOrderTab"]</button>
            </div>
            <div id="text-panel" role="tabpanel" aria-labelledby="text-tab" hidden="@_orderTab">
                <label for="waypoints">TomTom / Wowhead</label>
                <textarea id="waypoints" spellcheck="false" aria-describedby="validation" aria-invalid="@(_validation is not null ? "true" : "false")" @bind:get="_input" @bind:set="SetInput" @bind:event="oninput" placeholder="/way #2437 34.39 33.04 Necrohexxer Raz'ka"></textarea>
            </div>
            <div id="order-panel" role="tabpanel" aria-labelledby="order-tab" hidden="@(!_orderTab)">
                @if (_orderTab)
                {
                    <div class="route-optimization">
                        <div>
                            <label for="route-shape">@Text["RouteShape"]</label>
                            <select id="route-shape" @bind:get="_routeShape" @bind:set="SetRouteShape"
                                    aria-describedby="route-shape-hint" disabled="@_optimizing">
                                <option value="path">@Text["ShortestPath"]</option>
                                <option value="loop">@Text["Loop"]</option>
                            </select>
                        </div>
                        <button type="button" class="button primary" @onclick="OptimizeRoute"
                                disabled="@(_points.Count < 2 || _optimizing)">@Text["Optimize"]</button>
                    </div>
                    <p id="route-shape-hint" class="field-note">@Text[IsLoop ? "LoopHint" : "ShortestPathHint"]</p>
                    <p class="field-note" id="waypoint-order-hint">@Text[OrderHint]</p>
                }
                <ol class="waypoint-order" data-revision="@_inputVersion" aria-describedby="waypoint-order-hint" hidden="@(_points.Count == 0)">
                    @if (_orderTab)
                    {
                        @for (var i = 0; i < _points.Count; i++)
                        {
                            var index = i;
                            var point = _points[index];
                            var label = point.Name.Length == 0 ? Text.Format("Point", index + 1) : point.Name;
                            <li class="waypoint-row" data-index="@index">
                                @if (_points.Count > 1)
                                {
                                    <span class="drag-handle" data-drag-handle aria-hidden="true">⠿</span>
                                }
                                <span class="waypoint-detail">
                                    <strong>@label</strong>
                                    <small>@(string.Create(Text.Culture, $"X {point.X} · Y {point.Y}"))</small>
                                </span>
                                <button type="button" class="button secondary small" data-move="-1" disabled="@(index == 0)"
                                        aria-label="@Text.Format("MoveWaypointUp", label)" @onclick="() => MoveWithButton(index, -1)">↑</button>
                                <button type="button" class="button secondary small" data-move="1" disabled="@(index == _points.Count - 1)"
                                        aria-label="@Text.Format("MoveWaypointDown", label)" @onclick="() => MoveWithButton(index, 1)">↓</button>
                            </li>
                        }
                    }
                </ol>
                <p id="optimization-status" class="field-note @(_optimizationStatus == "OptimizationFailed" ? "error" : "")" role="status">
                    @(_optimizing ? Text["Optimizing"] : _optimizationStatus is { } status ? Text[status] : "")
                </p>
            </div>
            <p id="validation" class="field-note @(_validation is null ? "valid" : "error")" role="status">@(_validation ?? (_points.Count == 0 ? Text["WaypointHint"] : Text.Format(_points.Count == 1 ? "ValidWaypoint" : "ValidWaypoints", _points.Count)))</p>
            <label for="route-name">@Text["RouteName"]</label>
            <input id="route-name" type="text" @bind:get="_name" @bind:set="SetName" @bind:event="oninput">
            <div class="actions">
                <button class="button primary" @onclick="ConvertRoute" disabled="@(_points.Count == 0)"><span aria-hidden="true">↗</span> @Text["ExportRoute"]</button>
                <button class="button quiet" @onclick="Clear" disabled="@(string.IsNullOrEmpty(_input))">@Text["Clear"]</button>
            </div>
            <div class="export">
                <div class="panel-heading">
                    <label for="export-string">@Text["ImportString"]</label>
                    <button class="button secondary small" disabled="@(_output.Length == 0)" @onclick="CopyExport">@(_copied ? Text["Copied"] : Text["Copy"])</button>
                </div>
                <textarea id="export-string" @ref="_exportField" readonly spellcheck="false" value="@_output" placeholder="!FP1! …"></textarea>
                <p class="field-note @(_exportError ? "error" : "")" role="status">@Text[_feedbackKey ?? "ImportHint"]</p>
            </div>
        </section>

        <RouteMap Points="_points" ReturnToStart="IsLoop" @ref="_routeMap" />
    </div>
</main>

@code {
    private const string Example = """
        /way #2437 34.39 33.04 Necrohexxer Raz'ka
        /way #2437 51.84 72.92 Skullcrusher Harak
        /way #2437 50.86 65.17 Mrrlokk
        """;
    private string _input = "";
    private string _name = "";
    private string _output = "";
    private string? _validation;
    private string? _feedbackKey;
    private bool _exportError;
    private bool _copied;
    private bool _orderTab;
    private string _routeShape = "path";
    private bool _optimizing;
    private string? _optimizationStatus;
    private int _inputVersion;
    private RouteMap? _routeMap;
    private ElementReference _editor;
    private ElementReference _exportField;
    private IJSObjectReference? _orderModule;
    private DotNetObjectReference<App>? _editorReference;
    private (int Index, int Direction)? _moveFocus;
    private IReadOnlyList<Waypoint> _points = [];
    private int? MapId => _points.Count == 0 ? null : _points[0].MapId;
    private bool IsLoop => _routeShape == "loop";
    private string OrderHint => _validation is not null ? "OrderFixText" : _points.Count switch
    {
        0 => "OrderEmpty",
        1 => "OrderSingle",
        _ => "OrderInstructions"
    };

    protected override void OnInitialized() => LoadExample();

    private async Task ChangeLanguage(string preference)
    {
        try
        {
            Text.Apply(await JS.InvokeAsync<Localization>("routeStudio.setLanguage", preference));
            if (_validation is not null) ParseInput();
        }
        catch (JSException) { }
    }

    private void SetInput(string? value)
    {
        _input = value ?? "";
        _inputVersion++;
        _optimizationStatus = null;
        InvalidateExport();
        ParseInput();
    }

    [JSInvokable]
    public Task MoveDroppedWaypoint(int from, int to, int revision) => InvokeAsync(() =>
    {
        if (_orderTab && revision == _inputVersion && MoveWaypoint(from, to)) StateHasChanged();
    });

    private void MoveWithButton(int from, int direction)
    {
        int to = from + direction;
        if (MoveWaypoint(from, to)) _moveFocus = (to, direction);
    }

    private bool MoveWaypoint(int from, int to)
    {
        if (from == to || (uint)from >= (uint)_points.Count || (uint)to >= (uint)_points.Count) return false;

        var order = Enumerable.Range(0, _points.Count).ToList();
        order.RemoveAt(from);
        order.Insert(to, from);
        SetInput(WaypointParser.ReorderLines(_input, order));
        return true;
    }

    private void SetRouteShape(string? shape)
    {
        _routeShape = shape == "loop" ? "loop" : "path";
        _optimizationStatus = null;
    }

    private async Task OptimizeRoute()
    {
        if (_points.Count < 2 || _optimizing) return;
        if (_orderModule is null)
        {
            _optimizationStatus = "OptimizationFailed";
            return;
        }

        _optimizing = true;
        _optimizationStatus = null;
        var revision = _inputVersion;
        try
        {
            var coordinates = _points.Select(point => new[] { point.X, point.Y }).ToArray();
            var order = await _orderModule.InvokeAsync<int[]>("optimize", coordinates, IsLoop, _routeMap?.DistanceAspect ?? 1);
            if (revision != _inputVersion) return;

            if (!order.SequenceEqual(Enumerable.Range(0, _points.Count)))
            {
                SetInput(WaypointParser.ReorderLines(_input, order));
                _optimizationStatus = "OptimizationComplete";
            }
            else
            {
                _optimizationStatus = "OptimizationUnchanged";
            }
        }
        catch (JSException)
        {
            if (revision == _inputVersion) _optimizationStatus = "OptimizationFailed";
        }
        finally { _optimizing = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                _orderModule = await JS.InvokeAsync<IJSObjectReference>("import", "./waypoint-order.js");
                _editorReference = DotNetObjectReference.Create(this);
                await _orderModule.InvokeVoidAsync("attach", _editor, _editorReference);
            }

            if (_moveFocus is { } focus && _orderModule is not null)
            {
                _moveFocus = null;
                await _orderModule.InvokeVoidAsync("focusMove", _editor, focus.Index, focus.Direction);
            }
        }
        catch (JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_orderModule is not null)
            {
                await _orderModule.InvokeVoidAsync("detach", _editor);
                await _orderModule.DisposeAsync();
            }
        }
        catch (JSException) { }
        finally { _editorReference?.Dispose(); }
    }

    private void ParseInput()
    {
        _points = [];
        _validation = null;
        if (string.IsNullOrWhiteSpace(_input)) return;

        try { _points = WaypointParser.Parse(_input, Text); }
        catch (FormatException error) { _validation = error.Message; }
    }

    private void SetName(string? value)
    {
        _name = value ?? "";
        InvalidateExport();
    }

    private void LoadExample()
    {
        _name = Text["ExampleRouteName"];
        SetInput(Example);
    }

    private void Clear() => SetInput("");

    private void InvalidateExport()
    {
        _output = "";
        _feedbackKey = null;
        _exportError = false;
        _copied = false;
    }

    private void ConvertRoute()
    {
        InvalidateExport();
        if (_points.Count == 0) return;

        var name = _name.Trim();
        if (name.Length == 0 || System.Text.Encoding.UTF8.GetByteCount(name) > 200)
        {
            _exportError = true;
            _feedbackKey = name.Length == 0 ? "NameRequired" : "NameTooLong";
            return;
        }

        _output = FarmingPathsCodec.Encode(_points, name);
        _feedbackKey = "ExportReady";
    }

    private async Task CopyExport()
    {
        var current = _output;
        bool success;
        try { success = await JS.InvokeAsync<bool>("routeStudio.copyExport", _exportField); }
        catch (JSException)
        {
            _feedbackKey = "CopyFailed";
            return;
        }
        if (current != _output) return;

        _copied = success;
        _feedbackKey = success ? "ExportCopied" : "ExportSelected";
    }
}

