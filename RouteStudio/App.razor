@inject IJSRuntime JS

<header class="topbar">
    <div class="shell nav">
        <a class="brand" href="./"><img src="compass.svg" alt="" width="40" height="40"><span>Route Studio<small>SC FARMING PATHS</small></span></a>
        <select id="language" aria-label="@Text["Language"]" @bind:get="Text.Preference" @bind:set="ChangeLanguage">
            <option value="">@Text["BrowserDefault"]</option>
            <option value="de" lang="de">Deutsch</option>
            <option value="en" lang="en">English</option>
            <option value="es" lang="es">Español</option>
            <option value="it" lang="it">Italiano</option>
            <option value="pt" lang="pt">Português</option>
        </select>
    </div>
</header>

<main class="shell">
    <section class="hero" aria-labelledby="hero-title">
        <h1 id="hero-title">Route <em>Studio</em></h1>
        <p>@Text["HeroDescription"]</p>
    </section>

    <dl class="metrics">
        <div><dt>@Text["Waypoints"]</dt><dd>@(_points.Count == 0 ? "—" : _points.Count.ToString("D2"))</dd></div>
        <div><dt>@Text["MapId"]</dt><dd>@(MapId is int id ? $"#{id}" : "—") @if (MapId == 2437) { <small>Zul’Aman</small> }</dd></div>
    </dl>

    <div class="workspace">
        <section class="panel editor" id="editor" aria-labelledby="editor-heading">
            <div class="panel-heading">
                <h2 id="editor-heading">@Text["Waypoints"]</h2>
                <button class="button secondary small" @onclick="LoadExample">@Text["LoadExample"]</button>
            </div>
            <label for="waypoints">TomTom / Wowhead</label>
            <textarea id="waypoints" spellcheck="false" aria-describedby="validation" aria-invalid="@(_validation is not null ? "true" : "false")" @bind:get="_input" @bind:set="SetInput" @bind:event="oninput" placeholder="/way #2437 34.39 33.04 Necrohexxer Raz'ka"></textarea>
            <p id="validation" class="field-note @(_validation is null ? "valid" : "error")" role="status">@(_validation ?? (_points.Count == 0 ? Text["WaypointHint"] : Text.Format(_points.Count == 1 ? "ValidWaypoint" : "ValidWaypoints", _points.Count)))</p>
            <label for="route-name">@Text["RouteName"]</label>
            <input id="route-name" type="text" @bind:get="_name" @bind:set="SetName" @bind:event="oninput">
            <div class="actions">
                <button class="button primary" @onclick="ConvertRoute" disabled="@(_points.Count == 0)"><span aria-hidden="true">↗</span> @Text["ExportRoute"]</button>
                <button class="button quiet" @onclick="Clear" disabled="@(string.IsNullOrEmpty(_input))">@Text["Clear"]</button>
            </div>
            <div class="export">
                <div class="panel-heading">
                    <label for="export-string">@Text["ImportString"]</label>
                    <button class="button secondary small" disabled="@(_output.Length == 0)" @onclick="CopyExport">@(_copied ? Text["Copied"] : Text["Copy"])</button>
                </div>
                <textarea id="export-string" @ref="_exportField" readonly spellcheck="false" value="@_output" placeholder="!FP1! …"></textarea>
                <p class="field-note @(_exportError ? "error" : "")" role="status">@Text[_feedbackKey ?? "ImportHint"]</p>
            </div>
        </section>

        <RouteMap Points="_points" />
    </div>
</main>

@code {
    private const string Example = """
        /way #2437 34.39 33.04 Necrohexxer Raz'ka
        /way #2437 51.84 72.92 Skullcrusher Harak
        /way #2437 50.86 65.17 Mrrlokk
        """;
    private string _input = "";
    private string _name = "";
    private string _output = "";
    private string? _validation;
    private string? _feedbackKey;
    private bool _exportError;
    private bool _copied;
    private ElementReference _exportField;
    private IReadOnlyList<Waypoint> _points = [];
    private int? MapId => _points.Count == 0 ? null : _points[0].MapId;

    protected override void OnInitialized() => LoadExample();

    private async Task ChangeLanguage(string preference)
    {
        try
        {
            Text.Apply(await JS.InvokeAsync<Localization>("routeStudio.setLanguage", preference));
            if (_validation is not null) ParseInput();
        }
        catch (JSException) { }
    }

    private void SetInput(string? value)
    {
        _input = value ?? "";
        InvalidateExport();
        ParseInput();
    }

    private void ParseInput()
    {
        _points = [];
        _validation = null;
        if (string.IsNullOrWhiteSpace(_input)) return;

        try { _points = WaypointParser.Parse(_input, Text); }
        catch (FormatException error) { _validation = error.Message; }
    }

    private void SetName(string? value)
    {
        _name = value ?? "";
        InvalidateExport();
    }

    private void LoadExample()
    {
        _name = Text["ExampleRouteName"];
        SetInput(Example);
    }

    private void Clear() => SetInput("");

    private void InvalidateExport()
    {
        _output = "";
        _feedbackKey = null;
        _exportError = false;
        _copied = false;
    }

    private void ConvertRoute()
    {
        InvalidateExport();
        if (_points.Count == 0) return;

        var name = _name.Trim();
        if (name.Length == 0 || System.Text.Encoding.UTF8.GetByteCount(name) > 200)
        {
            _exportError = true;
            _feedbackKey = name.Length == 0 ? "NameRequired" : "NameTooLong";
            return;
        }

        _output = FarmingPathsCodec.Encode(_points, name);
        _feedbackKey = "ExportReady";
    }

    private async Task CopyExport()
    {
        var current = _output;
        bool success;
        try { success = await JS.InvokeAsync<bool>("routeStudio.copyExport", _exportField); }
        catch (JSException)
        {
            _feedbackKey = "CopyFailed";
            return;
        }
        if (current != _output) return;

        _copied = success;
        _feedbackKey = success ? "ExportCopied" : "ExportSelected";
    }
}

